{
    "name": "offline-agency/laravel-fatture-in-cloud-v2",
    "description": "Laravel SDK for the Fatture in Cloud API v2: invoices, e-invoicing (fatturazione elettronica), clients, products and more, with typed entities, auto-pagination, rate-limit handling and multi-company support.",
    "keywords": [
        "laravel",
        "laravel-package",
        "laravel-boost",
        "fatture-in-cloud",
        "fattureincloud",
        "fatture in cloud api",
        "fatturazione elettronica",
        "fattura elettronica",
        "e-invoicing",
        "invoicing",
        "invoice",
        "sdi",
        "italy",
        "api-client",
        "sdk"
    ],
    "homepage": "https://docs.offlineagency.com/laravel-fatture-in-cloud-v2/",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Offline Agency",
            "email": "info@offlineagency.it"
        }
    ],
    "support": {
        "issues": "https://github.com/offline-agency/laravel-fatture-in-cloud-v2/issues",
        "source": "https://github.com/offline-agency/laravel-fatture-in-cloud-v2",
        "docs": "https://docs.offlineagency.com/laravel-fatture-in-cloud-v2/",
        "security": "https://github.com/offline-agency/laravel-fatture-in-cloud-v2/security/policy"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/offline-agency"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.1",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "OfflineAgency\\LaravelFattureInCloudV2\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OfflineAgency\\LaravelFattureInCloudV2\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --parallel",
        "test:coverage": "vendor/bin/pest --parallel --coverage --min=100",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@format:test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OfflineAgency\\LaravelFattureInCloudV2\\LaravelFattureInCloudV2ServiceProvider"
            ],
            "aliases": {
                "LaravelFattureInCloudV2": "OfflineAgency\\LaravelFattureInCloudV2\\LaravelFattureInCloudV2Facade"
            }
        }
    }
}
